# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Debug Options (optional - set to false in production)
VITE_DEBUG_API=false
VITE_DEBUG_FIREBASE=false
VITE_DEBUG_DATABASE=false

# Force Firebase connection tests even in development (optional)
# VITE_FORCE_FIREBASE_TESTS=false

# Optional admin emails (comma separated) for full order visibility
# VITE_ADMIN_EMAILS=admin@example.com,owner@example.com
